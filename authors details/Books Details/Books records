import java.sql.*;

public class Add30Books {

    public static void main(String[] args) {
        String url = "jdbc:mysql://localhost:3306/library_db";
        String user = "root";
        String password = "yourpassword";

        // 30 book titles (edit these as needed)
        String[] titles = {
            "Ramayanam ","Mahabharatham", "The Lost Temple", "Silent Waters", "Beyond the Horizon", "City of Dreams",
            "The Last Letter", "Whispering Winds", "Echoes of Time", "The Golden Path",
            "Shadows of Yesterday", "River of Stories", "The Hidden Truth", "Winter's Tale",
            "The Forgotten Road", "Voices in the Dark", "The Silver Thread", "Rain on Stone",
            "The Long Journey", "Between Two Worlds", "The Quiet Storm", "Mountains of Silence",
            "The Broken Promise", "Light After Dark", "The Endless Sky", "Song of the Earth",
            "The Painted Door", "Fields of Memory", "The Distant Shore", "Autumn Chronicles",
            "The Waiting Room", "Threads of Fate"
        };

        // corresponding types (must match titles.length)
        String[] types = {
            "Book","Book","Book", "Book", "Article", "Book", "Journal", "Book", "Article", "Book",
            "Book", "Journal", "Book", "Article", "Book", "Book", "Journal", "Book",
            "Article", "Book", "Book", "Journal", "Book", "Article", "Book", "Book",
            "Journal", "Book", "Article", "Book", "Book", "Journal"
        };

        try (Connection con = DriverManager.getConnection(url, user, password)) {
            con.setAutoCommit(false);

            // get all existing author_ids from DB (so we don't add new authors)
            java.util.List<Integer> authorIds = new java.util.ArrayList<>();
            Statement st = con.createStatement();
            ResultSet rs = st.executeQuery("SELECT author_id FROM authors");
            while (rs.next()) {
                authorIds.add(rs.getInt("author_id"));
            }

            if (authorIds.isEmpty()) {
                System.out.println("No authors found. Add authors first.");
                return;
            }

            String sql = "INSERT INTO books (title, author_id, type, available) VALUES (?, ?, ?, ?)";
            PreparedStatement ps = con.prepareStatement(sql);

            for (int i = 0; i < titles.length; i++) {
                int authorId = authorIds.get(i % authorIds.size()); // cycles through existing authors
                ps.setString(1, titles[i]);
                ps.setInt(2, authorId);
                ps.setString(3, types[i]);
                ps.setBoolean(4, true);
                ps.addBatch();
            }

            ps.executeBatch();
            con.commit();
            System.out.println(titles.length + " books inserted using existing authors only.");

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}
