        try (Connection con = DriverManager.getConnection(url, user, password)) {
            con.setAutoCommit(false);

            // Insert authors
            String authorSQL = "INSERT INTO authors (author_id, name) VALUES (?, ?)";
            PreparedStatement authorStmt = con.prepareStatement(authorSQL);
            for (int i = 0; i < authors.length; i++) {
                authorStmt.setInt(1, i + 1);
                authorStmt.setString(2, authors[i]);
                authorStmt.addBatch();
            }
            authorStmt.executeBatch();
            System.out.println(authors.length + " authors inserted.");

            // Insert their works (books/articles/journals)
            String bookSQL = "INSERT INTO books (title, author_id, type, available) VALUES (?, ?, ?, ?)";
            PreparedStatement bookStmt = con.prepareStatement(bookSQL);

            int bookCount = 0;
            for (int i = 0; i < works.length; i++) {
                for (String[] work : works[i]) {
                    bookStmt.setString(1, work[0]);       // title
                    bookStmt.setInt(2, i + 1);            // author_id
                    bookStmt.setString(3, work[1]);       // type
                    bookStmt.setBoolean(4, true);
                    bookStmt.addBatch();
                    bookCount++;
                }
            }
            bookStmt.executeBatch();
            con.commit();
            System.out.println(bookCount + " books/articles inserted.");

        } catch (SQLException e) {
            e.printStackTrace();
        }
